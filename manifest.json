{
  "manifest_version": 3,
  "name": "Focus Lock Pomodoro",
  "version": "1.0.0",
  "description": "Pomodoro 25/5 phút — màn nghỉ khoá bằng nội dung giải trí để tránh nghỉ quá giờ.",
  "permissions": ["alarms", "storage", "tabs", "notifications"],
  "host_permissions": [
    "https://tuoitre.vn/*",
    "https://thanhnien.vn/*",
    "https://vnexpress.net/*",
    "https://dantri.com.vn/*",
    "https://znews.vn/*",
    "https://feeds.bbci.co.uk/*",
    "https://rss.nytimes.com/*",
    "https://news.google.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["break.html", "break.css", "break.js", "focus.html", "focus.css", "focus.js", "setup.html", "setup.css", "setup.js", "blocked.html", "blocked.css", "blocked.js", "media/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
